{
  "mcpServers": {
    "freehire": {
      "url": "https://freehire.me/api/v1/mcp"
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "fiverr": {
      "serverUrl": "https://mcp.fiverr.com/mcp"
    },
    "freelancer.com": {
      "serverUrl": "https://mcp.freelancer.com/mcp"
    },
    "upwork": {
      "serverUrl": "https://mcp.upwork.com/mcp"
    }
  }
}