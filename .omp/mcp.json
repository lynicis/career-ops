{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "fiverr": {
      "type": "http",
      "url": "https://mcp.fiverr.com/mcp"
    },
    "upwork": {
      "type": "http",
      "url": "https://mcp.upwork.com/mcp",
      "auth": {
        "type": "oauth",
        "credentialId": "mcp_oauth:profile:default:https://mcp.upwork.com/mcp",
        "tokenUrl": "https://www.upwork.com/api/v3/oauth2/token",
        "resource": "https://mcp.upwork.com/mcp",
        "clientId": "389cf9ec9b6c24bb716d6412c960c55f"
      }
    },
    "freelancer.com": {
      "type": "http",
      "url": "https://mcp.freelancer.com/mcp",
      "auth": {
        "type": "oauth",
        "credentialId": "mcp_oauth:profile:default:https://mcp.freelancer.com/mcp",
        "tokenUrl": "https://mcp.freelancer.com/oauth/token",
        "resource": "https://mcp.freelancer.com/mcp",
        "clientId": "LiwzbgDFzdonf0q4nzf8rg"
      }
    }
  }
}